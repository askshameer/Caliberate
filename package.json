{
  "name": "caliberate",
  "version": "2.5.1",
  "description": "Caliberate — Resource Utilization & Deployment Tracker",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && node --watch index.js",
    "dev:client": "cd client && npx vite --host",
    "postinstall": "node scripts/build.mjs --deps-only",
    "build": "node scripts/build.mjs",
    "start": "node server/index.js",
    "seed": "cd server && node db/init.js --force",
    "lint": "cd client && npx oxlint",
    "test": "node test_all_features.mjs",
    "test:admin": "node test_reset_login.mjs",
    "test:availability": "node --test test_panel_availability.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
