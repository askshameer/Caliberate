# ─────────────────────────────────────────────────────────────
# Caliberate runtime configuration
# Copy this file to .env and adjust values for your environment.
# Never commit a real .env file or production secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
SESSION_COOKIE_NAME=caliberate_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Set to 1 when running behind a trusted reverse proxy / load balancer
TRUST_PROXY=

# Comma-separated browser origins allowed to call the API. Leave empty for
# same-origin deployments. Development defaults to the Vite dev server.
CORS_ORIGINS=

# Demo mode seeds the five persona accounts and sample workforce data and
# enables one-click persona sign-in. Turn this OFF in production.
DEMO_MODE=true
SEED_DEMO_DATA=true

# First-run production administrator. Required when the database is empty and
# DEMO_MODE is false. The password must satisfy the 12+ character policy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-temporary-password
ADMIN_NAME=Platform Administrator

# Persistence (relative paths resolve against the server directory)
DB_PATH=./db/caliberate.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# Password hashing cost
BCRYPT_ROUNDS=12

# Logging
LOG_FORMAT=dev
APP_VERSION=1.0.0
